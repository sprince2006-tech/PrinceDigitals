# Base URL for Backend REST API
# In local development:
VITE_API_URL=http://localhost:5000/api/v1

# In production on Vercel (Project Settings -> Environment Variables):
# Either VITE_API_URL or VITE_API_BASE_URL is supported:
# VITE_API_URL=https://prince-digital-api.onrender.com
# (or: VITE_API_URL=https://prince-digital-api.onrender.com/api/v1)
