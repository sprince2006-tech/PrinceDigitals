# ========================================================
# PRINCE DIGITAL — BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Host URL of your deployed or local backend (used for OAuth redirects)
BACKEND_URL=http://localhost:5000
# Host URL of your frontend (for CORS and OAuth redirect destination)
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/princedigital?retryWrites=true&w=majority

# Session Security (Generate a secure 64-character random string)
SESSION_SECRET=your_super_secret_session_jwt_key_at_least_32_characters_long
# Cookie settings (for cross-domain Vercel <-> Render, leave empty to auto-detect or set to 'none')
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Designated Administrator Email (Only this email will be allowed via Google login)
ADMIN_EMAIL=admin@princedigital.com

# Optional Admin Username & Password Authentication
# Generate hash using: npm run hash-password "YourPassword"
ADMIN_USERNAME=princeadmin
ADMIN_PASSWORD_HASH=$2a$12$ExampleHashedPasswordStringGoesHere1234567890

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
MAX_IMAGE_SIZE_MB=5
